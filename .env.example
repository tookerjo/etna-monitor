# Copy to .env for local runs, or set these as repository secrets for the
# GitHub Actions workflow. Never commit a file containing real values.

# Required. Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=replace_with_your_firms_map_key

# Required for the ntfy.sh channel (the primary notification channel).
# Any topic string works; treat it as a shared secret since anyone who
# knows it can read or post to it.
NTFY_TOPIC=replace_with_your_ntfy_topic

# Optional. Only used if notify.smtp.enabled is true in config.yaml.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
